generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Club {
  id       Int    @id @default(autoincrement()) @map("ID_CLUB") @db.UnsignedInt
  idClubEq String @map("ID_CLUB_EQ") @db.VarChar(10)
  name     String @default("") @map("NAME") @db.VarChar(50)
  seasonId Int?   @map("ID_SEASON") @db.UnsignedInt

  season Season? @relation(fields: [seasonId], references: [id])

  @@index([id], map: "ID_CLUB")
  @@index([name], map: "NAME")
  @@index([seasonId], map: "ID_SEASON")
  @@map("CLUB")
}

model ClubValid {
  clubId  Int      @map("ID_CLUB")
  day     Int      @map("DAY")
  isValid Int      @map("IS_VALID")
  dtValid DateTime @map("DT_VALID") @db.DateTime(0)

  @@id([clubId, day])
  @@map("CLUB_VALID")
}

model League {
  id        Int    @id @default(autoincrement()) @map("ID_LEAGUE") @db.UnsignedInt
  chiefId   Int    @default(0) @map("ID_CHIEF")
  forumId   Int    @default(0) @map("ID_FORUM")
  name      String @default("") @map("NAME") @db.VarChar(50)
  firstYear Int    @default(0) @map("FIRST_YEAR")

  seasonId      Int?    @map("ID_SEASON") @db.UnsignedInt
  divisionLabel String? @map("DIVISION_LABEL") @db.VarChar(50)
  tier          Int?    @map("TIER")

  season Season? @relation(fields: [seasonId], references: [id])

  @@index([firstYear], map: "FIRST_YEAR")
  @@index([chiefId], map: "ID_CHIEF")
  @@index([forumId], map: "ID_FORUM")
  @@index([id], map: "ID_LEAGUE")
  @@index([name], map: "NAME")
  @@index([seasonId], map: "ID_SEASON_LEAGUE")
  @@map("LEAGUE")
}

model LeagueUser {
  leagueId Int @default(0) @map("ID_LEAGUE") @db.UnsignedInt
  userId   Int @default(0) @map("ID_USER") @db.UnsignedInt

  @@id([leagueId, userId])
  @@index([leagueId], map: "ID_LEAGUE")
  @@index([userId], map: "ID_USER")
  @@map("LEAGUE_USER")
}

model Player {
  id       Int     @id @default(autoincrement()) @map("ID_PLAYER") @db.UnsignedInt
  clubId   Int     @default(0) @map("ID_CLUB") @db.UnsignedInt
  fname    String  @default("") @map("FNAME") @db.VarChar(50)
  lname    String  @default("") @map("LNAME") @db.VarChar(50)
  position String  @default("") @map("POSITION") @db.VarChar(50)
  link     String? @map("LINK") @db.VarChar(150)
  photoUrl String? @map("PHOTO_URL") @db.VarChar(255)
  seasonId Int?    @map("ID_SEASON") @db.UnsignedInt

  season Season? @relation(fields: [seasonId], references: [id])

  @@index([fname], map: "FNAME")
  @@index([clubId], map: "ID_CLUB")
  @@index([id], map: "ID_PLAYER")
  @@index([link], map: "LINK")
  @@index([lname], map: "LNAME")
  @@index([position], map: "POSITION")
  @@index([seasonId], map: "ID_SEASON_PLAYER")
  @@map("PLAYER")
}

model Score {
  playerId Int     @default(0) @map("ID_PLAYER") @db.UnsignedInt
  day      Int     @default(0) @map("DAY") @db.UnsignedInt
  used     Int     @default(0) @map("USED") @db.UnsignedInt
  points   Decimal @default(0.0) @map("POINTS") @db.Decimal(3, 1)
  goals        Int @default(0) @map("GOALS") @db.UnsignedInt
  passes       Int @default(0) @map("PASSES") @db.UnsignedInt
  redCard      Int @default(0) @map("RED_CARD") @db.UnsignedTinyInt
  ownGoals     Int @default(0) @map("OWN_GOALS") @db.UnsignedInt
  penaltySaved Int @default(0) @map("PENALTY_SAVED") @db.UnsignedInt

  @@id([playerId, day])
  @@index([day], map: "DAY")
  @@index([goals], map: "GOALS")
  @@index([playerId], map: "ID_PLAYER")
  @@index([passes], map: "PASSES")
  @@index([points], map: "POINTS")
  @@index([used], map: "USED")
  @@map("SCORE")
}

model StatsUser {
  userId     Int     @default(0) @map("ID_USER")
  leagueId   Int     @default(0) @map("ID_LEAGUE")
  day        Int     @default(0) @map("DAY")
  rankDay    Int     @default(0) @map("RANK_DAY")
  rankLeague Int     @default(0) @map("RANK_LEAGUE")
  rankGlobal Int     @default(0) @map("RANK_GLOBAL")
  playerUsed Int     @default(0) @map("PLAYER_USED")
  ptsGk      Decimal @default(0.0) @map("PTS_GK") @db.Decimal(5, 1)
  ptsDf      Decimal @default(0.0) @map("PTS_DF") @db.Decimal(5, 1)
  ptsMf      Decimal @default(0.0) @map("PTS_MF") @db.Decimal(5, 1)
  ptsSt      Decimal @default(0.0) @map("PTS_ST") @db.Decimal(5, 1)
  ptsPas     Int     @default(0) @map("PTS_PAS")
  ptsGls     Int     @default(0) @map("PTS_GLS")
  ptsFrf     Decimal @default(0.0) @map("PTS_FRF") @db.Decimal(5, 1)
  ptsTot     Decimal @default(0.0) @map("PTS_TOT") @db.Decimal(5, 1)

  @@id([userId, leagueId, day])
  @@index([day], map: "DAY")
  @@index([leagueId], map: "ID_LEAGUE")
  @@index([userId], map: "ID_USER")
  @@index([playerUsed], map: "PLAYER_USED")
  @@index([ptsDf], map: "PTS_DF")
  @@index([ptsFrf], map: "PTS_FRF")
  @@index([ptsGk], map: "PTS_GK")
  @@index([ptsGls], map: "PTS_GLS")
  @@index([ptsMf], map: "PTS_MF")
  @@index([ptsPas], map: "PTS_PAS")
  @@index([ptsSt], map: "PTS_ST")
  @@index([ptsTot], map: "PTS_TOT")
  @@index([rankDay], map: "RANK_DAY")
  @@index([rankGlobal], map: "RANK_GLOBAL")
  @@index([rankLeague], map: "RANK_LEAGUE")
  @@map("STATS_USER")
}

model Team {
  leagueId Int @default(0) @map("ID_LEAGUE") @db.UnsignedInt
  userId   Int @default(0) @map("ID_USER") @db.UnsignedInt
  playerId Int @default(0) @map("ID_PLAYER") @db.UnsignedInt
  dayFirst Int @default(1) @map("DAY_FIRST")
  dayLast  Int @default(38) @map("DAY_LAST")
  isSubs   Int @default(0) @map("IS_SUBS")

  @@id([leagueId, userId, playerId, dayFirst])
  @@index([dayFirst], map: "DAY_FIRST")
  @@index([dayLast], map: "DAY_LAST")
  @@index([leagueId], map: "ID_LEAGUE")
  @@index([playerId], map: "ID_PLAYER")
  @@index([userId], map: "ID_USER")
  @@map("TEAM")
}

model TeamDay {
  leagueId Int      @map("ID_LEAGUE")
  userId   Int      @map("ID_USER")
  playerId Int      @map("ID_PLAYER")
  day      Int      @map("DAY")
  indx     Int      @map("INDX")
  isValid  Int      @default(0) @map("IS_VALID")
  dtSave   DateTime @map("DT_SAVE") @db.DateTime(0)
  dtValid  DateTime @map("DT_VALID") @db.DateTime(0)

  @@id([leagueId, userId, playerId, day])
  @@map("TEAM_DAY")
}

model User {
  id       Int    @id @default(autoincrement()) @map("ID_USER") @db.UnsignedInt
  name     String @default("") @map("NAME") @db.VarChar(150)
  password String @default("") @map("PASSWORD") @db.VarChar(255)
  email    String @default("") @map("EMAIL") @db.VarChar(50)

  @@index([email], map: "EMAIL")
  @@index([id], map: "ID_USER")
  @@index([name], map: "NAME")
  @@map("USER")
}

model Season {
  id        Int          @id @default(autoincrement()) @map("ID_SEASON") @db.UnsignedInt
  label     String       @map("LABEL") @db.VarChar(20)
  status    SeasonStatus @default(SETUP) @map("STATUS")
  startedAt DateTime?    @map("STARTED_AT") @db.DateTime(0)
  closedAt  DateTime?    @map("CLOSED_AT") @db.DateTime(0)
  isCurrent Boolean      @default(false) @map("IS_CURRENT")

  leagues   League[]
  clubs     Club[]
  players   Player[]
  palmares  Palmares[]
  movements SeasonMovement[]

  @@index([status], map: "STATUS")
  @@index([isCurrent], map: "IS_CURRENT")
  @@map("SEASON")
}

enum SeasonStatus {
  SETUP
  AUCTION
  ACTIVE
  WINTER
  CLOSED
}

model Palmares {
  id            Int    @id @default(autoincrement()) @map("ID_PALMARES") @db.UnsignedInt
  seasonId      Int    @map("ID_SEASON") @db.UnsignedInt
  divisionLabel String @map("DIVISION_LABEL") @db.VarChar(50)
  position      String @map("POSITION") @db.VarChar(20)
  pseudo        String @map("PSEUDO") @db.VarChar(150)

  season Season @relation(fields: [seasonId], references: [id])

  @@index([seasonId], map: "ID_SEASON_PALMARES")
  @@map("PALMARES")
}

model SeasonMovement {
  id           Int          @id @default(autoincrement()) @map("ID_MOVEMENT") @db.UnsignedInt
  seasonId     Int          @map("ID_SEASON") @db.UnsignedInt
  userId       Int          @map("ID_USER") @db.UnsignedInt
  fromLeagueId Int          @map("FROM_LEAGUE_ID") @db.UnsignedInt
  fromTier     Int          @map("FROM_TIER")
  toTier       Int          @map("TO_TIER")
  type         MovementType @map("TYPE")
  rankFinal    Int          @map("RANK_FINAL")
  pseudo       String       @map("PSEUDO") @db.VarChar(150)
  overridden   Boolean      @default(false) @map("OVERRIDDEN")

  season Season @relation(fields: [seasonId], references: [id])

  @@index([seasonId], map: "ID_SEASON_MOVEMENT")
  @@map("SEASON_MOVEMENT")
}

enum MovementType {
  PROMOTION
  RELEGATION
  STAY
}

model AppConfig {
  name      String   @id @map("NAME") @db.VarChar(50)
  value     String?  @map("VALUE") @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("UPDATED_AT") @db.DateTime(0)

  @@map("APP_CONFIG")
}

// Table gérée via $queryRawUnsafe (pas de migrate Prisma — migrations manuelles dans sql/).
// Modèle documentaire uniquement ; ne pas utiliser prisma.auction.* dans le code.
model Auction {
  id             Int       @id @default(autoincrement()) @map("id") @db.UnsignedInt
  leagueId       Int       @map("league_id") @db.UnsignedInt
  status         String    @default("open") @map("status") @db.VarChar(20)
  currentRound   Int       @default(1) @map("current_round")
  budgetPerUser  Int       @default(130) @map("budget_per_user")
  playersPerUser Int       @default(13) @map("players_per_user")
  type           String?   @map("type") @db.VarChar(20)
  roundDeadline  DateTime? @map("round_deadline") @db.DateTime(0)

  @@map("AUCTION")
}

// Table gérée via $queryRawUnsafe (migration manuelle :
// sql/2026-06-encheres-depouillement.sql). Modèle documentaire uniquement ;
// ne pas utiliser prisma.auctionRemoval.* dans le code.
// Retraits de pénalité appliqués au dépouillement (règle 3.2.c), avec motif.
model AuctionRemoval {
  id        Int      @id @default(autoincrement()) @map("id") @db.UnsignedInt
  auctionId Int      @map("auction_id") @db.UnsignedInt
  round     Int      @map("round")
  userId    Int      @map("user_id") @db.UnsignedInt
  playerId  Int      @map("player_id") @db.UnsignedInt
  amount    Int      @map("amount")
  reason    String   @map("reason") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([auctionId, round], map: "idx_auction_round")
  @@index([userId], map: "idx_user")
  @@map("AUCTION_REMOVAL")
}
