# Base de données MySQL (prod : ligueenc_v3 sur VPS OVH)
DATABASE_URL="mysql://user:password@host:3306/ligueenc_v3"

# Auth admin (cookie admin_session == ADMIN_SECRET)
ADMIN_SECRET="change-me"

# Synthèse Lia
GEMINI_API_KEY=""

# ── API football (machine à saisons) ────────────────────────────────────────
# Provider principal : TheSportsDB (gratuit). Ligue 1 = league id 4334.
THESPORTSDB_KEY="3"                 # "3" = clé free tier publique
FOOTBALL_API_PROVIDER="thesportsdb"
# Effectifs servis en mock tant que l'endpoint premium n'est pas branché.
#   FOOTBALL_API_MOCK="true"  -> force le mock partout (clubs + effectifs)
#   FOOTBALL_API_MOCK="false" -> force le live (échoue si endpoint indisponible)
#   (non défini)              -> clubs live, effectifs mock, fallback mock si live KO
FOOTBALL_API_MOCK=""

# Photos joueurs (fallbacks, voir scripts/import-photos-*.ts)
API_FOOTBALL_KEY=""
