# Base de données MySQL (prod : ligueenc_v3 sur VPS OVH)
DATABASE_URL="mysql://user:password@host:3306/ligueenc_v3"

# Auth admin (cookie admin_session == ADMIN_SECRET)
ADMIN_SECRET="change-me"

# Synthèse Lia
GEMINI_API_KEY=""

# ── API football (machine à saisons) ────────────────────────────────────────
# Calendrier/scores : TheSportsDB gratuit. Ligue 1 = league id 4334.
THESPORTSDB_KEY="3"                 # "3" = clé free tier publique
# Effectifs (noms + postes) : football-data.org, tier GRATUIT, Ligue 1 = FL1.
# En prod le token se saisit dans Admin -> Configuration (table APP_CONFIG) ;
# cette env var n'est qu'un fallback local/dev.
FOOTBALL_DATA_TOKEN=""
# Photos joueurs : TheSportsDB premium (9$/mois, abonnement saisonnier au
# lancement). Idem : saisie admin en prod, env var = fallback dev.
THESPORTSDB_PREMIUM_KEY=""
#   FOOTBALL_API_MOCK="true"  -> force le mock partout (clubs + effectifs)
#   FOOTBALL_API_MOCK="false" -> force le live (échoue si endpoint indisponible)
#   (non défini)              -> live si token présent, sinon fallback mock
FOOTBALL_API_MOCK=""

# Photos joueurs (fallbacks, voir scripts/import-photos-*.ts)
API_FOOTBALL_KEY=""
